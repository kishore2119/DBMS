
-- Creating a temporary table for DML demonstration
create table students (
    rollno varchar2(30),
    name varchar2(30)
);

-- INSERT COMMAND
insert into students values('24B11CS234', 'Bala');
insert into students values('24B11CS381', 'Kiran');

-- SELECT COMMAND (Display all columns/rows)
select * from students;

-- SELECT COMMAND (Display specific column)
select name from students;

-- SELECT COMMAND (Display with WHERE condition)
select * from students where rollno='24B11CS234';

-- DELETE COMMAND
delete from students where rollno='24B11CS381';

-- UPDATE COMMAND
update students set name='Bala Raju' where rollno='24B11CS381';
